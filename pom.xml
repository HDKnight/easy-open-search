<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.hdknight</groupId>
    <artifactId>easy-open-search</artifactId>
    <version>0.1.3</version>
    <packaging>pom</packaging>
    <name>easy-open-search</name>
    <description>OpenSearch-only ORM: write via opensearch-java, read via sql-jdbc</description>
    <url>https://gitee.com/cocoknight/easy-open-search</url>

    <!-- 聚合工程本身不发布 -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <modules>
        <module>easy-os-parent</module>
        <module>easy-os-annotation</module>
        <module>easy-os-core</module>
        <module>easy-os-spring-boot-starter</module>
        <module>easy-os-spring-boot3-starter</module>
    </modules>

    <!-- sample 默认参与本地构建；正式发布用 -P release,!samples 排除 -->
    <profiles>
        <profile>
            <id>samples</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>easy-os-spring-boot-sample</module>
                <module>easy-os-spring-boot3-sample</module>
            </modules>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.9.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <excludeArtifacts>
                                <excludeArtifact>easy-os-spring-boot-sample</excludeArtifact>
                                <excludeArtifact>easy-os-spring-boot3-sample</excludeArtifact>
                                <excludeArtifact>easy-open-search</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
